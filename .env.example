# ── Runtime (Vercel → Project Settings → Environment Variables) ──
# Connection used by the web app: restricted role "ghamer_app" (never the postgres/owner role).
# Supabase: Project Settings → Database → Connection pooling (Transaction mode, port 6543)
DATABASE_URL=postgres://ghamer_app:APP_DB_PASSWORD@HOST:6543/postgres
# 32 random bytes, base64:  openssl rand -base64 32     (encrypts MFA secrets)
APP_ENCRYPTION_KEY=
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
SESSION_TTL_HOURS=12

# ── Only for running migrations / admin scripts from your computer (never put in Vercel) ──
# Supabase: direct connection (port 5432) with the "postgres" user
DATABASE_URL_ADMIN=postgres://postgres:ADMIN_PASSWORD@HOST:5432/postgres
APP_DB_PASSWORD=choose-a-long-random-password
